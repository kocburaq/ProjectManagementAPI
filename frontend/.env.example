# Backend API adresi.
# Backend varsayılan olarak http://0.0.0.0:5044 dinliyor (Properties/launchSettings.json → "http" profili)
# ve tüm endpoint'ler /api altında toplanıyor.
VITE_API_BASE_URL=http://localhost:5044/api

# Uygulama adı (topbar / sekme başlığı / login ekranı).
VITE_APP_NAME=Nexus

# Aynı Wi-Fi'daki telefondan test ederken kendi yerel IP'nizi yazın, örn:
# VITE_API_BASE_URL=http://192.168.1.25:5044/api
